<Page
    x:Class="graWKosci.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:graWKosci"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid
        VerticalAlignment="Center">

        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="120"/>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel
            Orientation="Horizontal"
            Grid.Row="0"
            HorizontalAlignment="Center">

            <Image
                Source="ms-appx:///Assets/dices/d0.png"
                x:Name="dice1"
                Margin="10"
                Tapped="dice1_Tapped"/>

            <Image
                Source="ms-appx:///Assets/dices/d0.png"
                x:Name="dice2"
                Margin="10"
                Tapped="dice2_Tapped"/>

        </StackPanel>

        <StackPanel
            Orientation="Horizontal"
            Grid.Row="1"
            HorizontalAlignment="Center">

            <Image
                Source="ms-appx:///Assets/dices/d0.png"
                x:Name="dice3"
                Margin="10"
                Tapped="dice3_Tapped"/>

            <Image
                Source="ms-appx:///Assets/dices/d0.png"
                x:Name="dice4"
                Margin="10"
                Tapped="dice4_Tapped"/>
            
            <Image
                Source="ms-appx:///Assets/dices/d0.png"
                x:Name="dice5"
                Margin="10"
                Tapped="dice5_Tapped"/>

        </StackPanel>

        <Button 
            Grid.Row="2"
            HorizontalAlignment="Center"
            Margin="10"
            Click="Rzut_Click">
            RZUT
        </Button>

        <TextBlock 
            Grid.Row="3"
            Text="0"
            FontSize="40"
            HorizontalAlignment="Center"
            x:Name="scoreTxt"
            />

    </Grid>
</Page>
